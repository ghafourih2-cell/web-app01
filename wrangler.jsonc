{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app01",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1805f7bf-e11f-43f8-8ba3-689b5bb03c04","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "76c2b046ddc841f49ab80fd0618b0955" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
